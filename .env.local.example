# Supabase Project Credentials
# 실제 연동 시 복사해서 .env.local 파일을 생성하고 본인의 Supabase 키를 입력하세요.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OAuth 리다이렉션을 위한 도메인 설정 (개발 시 로컬 3000 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only credentials. Do not expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
KTO_SERVICE_KEY=your-kto-service-key
# Optional provider-specific keys. When omitted, the public-data portal
# compatibility key above is used on the server.
KMA_SERVICE_KEY=your-kma-service-key
GG_BUS_SERVICE_KEY=your-gyeonggi-bus-service-key
SYNC_JOB_TOKEN=your-internal-sync-token

# Apple Sign In. client secret(JWT) 생성 전용 값이며 런타임에서는 사용하지 않는다.
# npm run apple:secret 으로 JWT를 만들어 Supabase Apple provider에 입력한다.
APPLE_TEAM_ID=your-apple-team-id
APPLE_SERVICE_ID=your.apple.services.id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_your-key-id.p8
